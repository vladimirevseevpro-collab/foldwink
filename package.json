{
  "name": "foldwink",
  "private": true,
  "version": "0.8.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run audio:check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-puzzles.ts",
    "lint": "eslint .",
    "test:e2e": "node tests/e2e/run-all.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audio:build": "node scripts/build-sound-pack.mjs",
    "audio:check": "node scripts/build-sound-pack.mjs --check",
    "pwa:icons": "node scripts/build-pwa-icons.mjs",
    "pack:itch": "npm run build && node scripts/pack-itch.mjs",
    "release:butler": "node scripts/release-butler.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:preflight:paid": "node scripts/release-preflight.mjs --paid",
    "gen:ru": "node scripts/generate-ru-puzzles.mjs",
    "gen:ru:dry": "node scripts/generate-ru-puzzles.mjs --dry-run --count=10",
    "gen:de": "node scripts/generate-de-puzzles.mjs",
    "gen:de:dry": "node scripts/generate-de-puzzles.mjs --dry-run --count=10",
    "tiktok:prep": "node scripts/tiktok-prep.mjs",
    "tiktok:compose:batch02": "node tiktok/video_automation/scripts/compose-tiktok-batch02.mjs",
    "audit:logic": "node scripts/audit-puzzle-logic.mjs",
    "validate:ru": "tsx scripts/validate-puzzles.ts --dir=puzzles/ru/pool",
    "validate:de": "tsx scripts/validate-puzzles.ts --dir=puzzles/de/pool",
    "mobile:assets": "node scripts/build-ios-icons.mjs",
    "mobile:sync": "npm run build && npm run mobile:assets && cap sync ios",
    "mobile:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.59.1",
    "postcss": "^8.4.49",
    "prettier": "^3.8.2",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
