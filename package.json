{
  "name": "foldwink",
  "private": true,
  "version": "0.8.4",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.14.1",
    "npm": "11.11.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run content:build && npm run notices:build && npm run audio:check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-puzzles.ts",
    "content:build": "node scripts/build-runtime-content.mjs",
    "content:check": "node scripts/build-runtime-content.mjs --check",
    "notices:build": "node scripts/build-third-party-notices.mjs",
    "notices:check": "node scripts/build-third-party-notices.mjs --check",
    "build:budget": "node scripts/check-build-budget.mjs",
    "pilot:summarize": "node scripts/summarize-pilot-exports.mjs",
    "pilot:summarize-observations": "node scripts/summarize-pilot-observations.mjs",
    "pilot:verify-operator-form": "node tests/visual/w7-operator-form-qa.mjs",
    "pilot:verify-channel": "node scripts/verify-butler-channel.mjs",
    "pilot:verify-staging": "node tests/visual/w7-itch-staging-qa.mjs",
    "pilot:check-contract": "node scripts/check-pilot-contract.mjs",
    "pilot:manifest": "node scripts/build-pilot-artifact-manifest.mjs",
    "lint": "eslint .",
    "test:e2e": "node tests/e2e/run-all.mjs",
    "test:e2e:diagnostic": "node tests/e2e/run-all.mjs --diagnostic-build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audio:build": "node scripts/build-sound-pack.mjs",
    "audio:check": "node scripts/build-sound-pack.mjs --check",
    "pwa:icons": "node scripts/build-pwa-icons.mjs",
    "pack:itch": "npm run build && node scripts/pack-itch.mjs",
    "release:butler": "node scripts/release-butler.mjs",
    "release:preflight": "node scripts/release-preflight.mjs && node scripts/check-pilot-contract.mjs",
    "release:preflight:paid": "node scripts/release-preflight.mjs --paid && node scripts/check-pilot-contract.mjs",
    "release:check": "node scripts/check-release-acceptance.mjs",
    "release:check:production": "node scripts/check-release-acceptance.mjs --production",
    "release:verify-rebuild": "node scripts/verify-exact-commit-build.mjs",
    "gen:ru": "node scripts/generate-ru-puzzles.mjs",
    "gen:ru:dry": "node scripts/generate-ru-puzzles.mjs --dry-run --count=10",
    "gen:de": "node scripts/generate-de-puzzles.mjs",
    "gen:de:dry": "node scripts/generate-de-puzzles.mjs --dry-run --count=10",
    "tiktok:prep": "node scripts/tiktok-prep.mjs",
    "tiktok:compose:batch02": "node tiktok/video_automation/scripts/compose-tiktok-batch02.mjs",
    "audit:logic": "node scripts/audit-puzzle-logic.mjs",
    "validate:ru": "tsx scripts/validate-puzzles.ts --dir=puzzles/ru/pool",
    "validate:de": "tsx scripts/validate-puzzles.ts --dir=puzzles/de/pool",
    "mobile:assets": "node scripts/build-ios-icons.mjs",
    "mobile:sync": "npm run build && npm run mobile:assets && cap sync ios",
    "mobile:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@ribpay/qr-code-generator": "^1.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "ffmpeg-static": "^5.3.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.59.1",
    "postcss": "8.5.28",
    "prettier": "^3.8.2",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.58.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
